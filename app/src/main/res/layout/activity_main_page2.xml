<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1020"
    android:padding="16dp">

    <!-- APP NAME -->
    <TextView
        android:id="@+id/txtAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1Night"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#3B82F6"
        android:letterSpacing="0.05"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <!-- CENTER CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <!-- STREAM IMAGE -->
        <ImageView
            android:id="@+id/imgStream"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/mba"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp" />

        <!-- STREAM NAME -->
        <TextView
            android:id="@+id/txtStreamName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engineering"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#E5E7EB"
            android:layout_marginBottom="6dp" />

        <!-- USER GUIDANCE -->
        <TextView
            android:id="@+id/txtInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select your branch and semester"
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:layout_marginBottom="20dp" />

        <!-- SELECT BRANCH -->
        <androidx.cardview.widget.CardView
            android:id="@+id/selectorBranch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0F172A"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/txtBranch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Select Branch"
                android:textColor="#9CA3AF"
                android:textSize="14sp"/>
        </androidx.cardview.widget.CardView>

        <!-- SELECT SEMESTER -->
        <androidx.cardview.widget.CardView
            android:id="@+id/selectorSemester"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0F172A"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/txtSemester"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Select Semester"
                android:textColor="#9CA3AF"
                android:textSize="14sp"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/selectorSubject"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0F172A"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/txtSubject"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Select Subject"
                android:textColor="#9CA3AF"
                android:textSize="14sp"/>
        </androidx.cardview.widget.CardView>

        <!-- GET PDF BUTTON -->
        <Button
            android:id="@+id/btnGetPdf"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Get Important Questions PDF"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6" />

    </LinearLayout>

</LinearLayout>
