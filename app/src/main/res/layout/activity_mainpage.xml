<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#0B1020"
    android:padding="16dp">


    <!-- APP NAME -->
    <TextView
        android:id="@+id/txtAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1Night"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#3B82F6"
        android:letterSpacing="0.05"
        android:layout_marginTop="8dp" />

    <!-- SUBTITLE -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select your Stream"
        android:textSize="20sp"
        android:textColor="#9CA3AF"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="16dp" />

    <!-- LIST VIEW / RECYCLER VIEW CONTAINER -->
    <ListView
        android:id="@+id/LV1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_glass_list"
        android:scrollbars="none" />

    <!-- ABOUT APP SECTION -->
    <androidx.cardview.widget.CardView
        android:id="@+id/aboutCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#111827">

        <LinearLayout
            android:id="@+id/aboutContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Title -->
            <TextView
                android:id="@+id/aboutTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About 1Night"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#F9FAFB"
                android:layout_marginBottom="14dp" />

            <!-- Bullet 1 -->
            <LinearLayout
                android:id="@+id/bullet1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/dot_blue" />

                <TextView
                    android:id="@+id/bulletText1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Exam-focused content for last-night preparation"
                    android:textSize="14sp"
                    android:textColor="#D1D5DB" />
            </LinearLayout>

            <!-- Bullet 2 -->
            <LinearLayout
                android:id="@+id/bullet2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <View
                    android:id="@+id/dot2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/dot_blue" />

                <TextView
                    android:id="@+id/bulletText2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Stream, branch and semester-wise curated PDFs"
                    android:textSize="14sp"
                    android:textColor="#D1D5DB" />
            </LinearLayout>

            <!-- Bullet 3 -->
            <LinearLayout
                android:id="@+id/bullet3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <View
                    android:id="@+id/dot3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/dot_blue" />

                <TextView
                    android:id="@+id/bulletText3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="High-weight questions with crisp explanations"
                    android:textSize="14sp"
                    android:textColor="#D1D5DB" />
            </LinearLayout>

            <!-- Bullet 4 -->
            <LinearLayout
                android:id="@+id/bullet4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot4"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/dot_blue" />

                <TextView
                    android:id="@+id/bulletText4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Designed specially for SPPU engineering students"
                    android:textSize="14sp"
                    android:textColor="#D1D5DB" />
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>



</LinearLayout>
