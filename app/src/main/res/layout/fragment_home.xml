<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Name -->
        <TextView
            android:text="NightStudy"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3B82F6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Ace exams with smart PDFs"
            android:textColor="#9CA3AF"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Search Bar -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Search subject, semester, exam..."
            android:padding="12dp"
            android:textColor="#E5E7EB"
            android:textColorHint="#9CA3AF"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="20dp"/>

        <!-- Section Title -->
        <TextView
            android:text="Trending PDFs"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#E5E7EB"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pdfRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</ScrollView>
