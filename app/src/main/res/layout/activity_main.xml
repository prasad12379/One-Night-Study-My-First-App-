<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020">
    <include layout="@layout/layoutbg_animation"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#111827">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- App Intro Image -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/introimg"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:visibility="visible"
                android:layout_marginLeft="10dp"
                app:lottie_fileName="intro_animation.json"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />


            <!-- App Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OneNightStudy"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#E5E7EB" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="Important questions that actually matter in exams"
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                android:gravity="center" />

            <!-- Get Started Button -->
            <Button
                android:id="@+id/btn1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Get Started"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3B82F6" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
